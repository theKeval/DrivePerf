---
// S-WEB-05 · Support and FAQ (DRIVE-179). FAQ data in components/pages/faq-data.ts; FAQPage JSON-LD for every answer.
import Base from '../layouts/Base.astro';
import DocHero from '../components/pages/DocHero.astro';
import Toc from '../components/pages/Toc.astro';
import FaqList from '../components/pages/FaqList.astro';
import { FAQ } from '../components/pages/faq-data';
import { SITE } from '../config/site';

const strip = (h: string) => h.replace(/<[^>]+>/g, '').replace(/&amp;/g, '&');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.flatMap((g) => g.items.map((i) => ({ '@type': 'Question', name: strip(i.q), acceptedAnswer: { '@type': 'Answer', text: strip(i.a) } }))),
};
const toc = [...FAQ.map((g) => ({ id: g.id, label: g.title })), { id: 'contact', label: 'Contact us' }];
---
<Base title="Support and FAQ · DrivePerf" description="Answers about DrivePerf: automatic capture, battery with the screen off, force-quitting, passenger trips, your data, Pro and cancelling." path="/support" screen="S-WEB-05" solidHeader jsonLd={jsonLd}>
  <DocHero crumbs={[{ label: 'Home', href: '/' }, { label: 'Support' }]} title="Support and FAQ">
    <p class="lede">Plain answers about recording, battery, your data and Pro. Can't find it? Email <a href={`mailto:${SITE.emails.support}`}>{SITE.emails.support}</a>.</p>
    <div class="field" style="max-width:560px;margin-top:28px">
      <label for="faq-search">Search the answers</label>
      <input class="input" id="faq-search" type="search" placeholder="Try “battery” or “cancel”" autocomplete="off">
      <p class="field-hint" id="faq-count" aria-live="polite"></p>
    </div>
  </DocHero>

  <div class="wrap doc">
    <Toc items={toc} label="Topics" />
    <div>
      <p id="faq-empty" class="lede" hidden>No answers match that. Email <a href={`mailto:${SITE.emails.support}`}>{SITE.emails.support}</a> and we'll help.</p>
      <FaqList groups={FAQ} />
      <section id="contact" class="cta-band" style="text-align:left;justify-items:start;padding:32px 24px" aria-labelledby="contact-title">
        <h2 class="h3" id="contact-title">Still stuck?</h2>
        <p class="muted" style="margin:0">Email us and a person will reply within a few business days. Include your phone model and app version from Settings, never your password.</p>
        <div class="btn-row"><a class="btn" href={`mailto:${SITE.emails.support}`}>{SITE.emails.support}</a><a class="btn btn--ghost" href={`mailto:${SITE.emails.privacy}`}>Privacy questions</a></div>
      </section>
    </div>
  </div>
  <script>import '../scripts/pages/faq-filter';</script>
</Base>
