---
// Neutral placeholders: no Apple or Google marks until the store listings exist (store badge guidelines).
import Icon from './Icon.astro';
---
<div class="badges" data-component="StoreBadges">
  <span class="store-badge" role="img" aria-label="Coming to the App Store"><Icon name="store" /><span><small>Coming to the</small><b>App Store</b></span></span>
  <span class="store-badge" role="img" aria-label="Coming to Google Play"><Icon name="phone" /><span><small>Coming to</small><b>Google Play</b></span></span>
</div>
