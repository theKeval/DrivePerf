---
// SiteHeader: sticky glass bar, nav, CTA, mobile disclosure menu (behaviour in src/scripts/site.ts).
import LoopMark from './LoopMark.astro';
import Icon from './Icon.astro';
interface Props { solid?: boolean }
const { solid = false } = Astro.props;
const NAV: [string, string][] = [
  ['How it works', '/#how'],
  ['Pricing', '/#pricing'],
  ['Privacy', '/#privacy'],
  ['Support', '/support'],
];
---
<header class:list={['site-header', { 'is-solid': solid }]} data-component="SiteHeader">
  <div class="wrap site-header__inner">
    <a class="brand" href="/" aria-label="DrivePerf home"><LoopMark size={34} id="dplh" /><span class="brand__word">DrivePerf</span></a>
    <nav class="site-nav" aria-label="Main">
      {NAV.map(([t, h]) => <a href={h}>{t}</a>)}
      <a class="btn btn--sm header-cta" href="/#waitlist">Join the waitlist</a>
    </nav>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu"><Icon name="menu" /></button>
  </div>
</header>
<div class="mobile-menu" id="mobile-menu" hidden>
  {NAV.map(([t, h]) => <a href={h}>{t}<span aria-hidden="true">→</span></a>)}
  <a href="/how-it-records">How DrivePerf records<span aria-hidden="true">→</span></a>
  <a class="btn btn--lg" href="/#waitlist">Join the waitlist</a>
</div>
