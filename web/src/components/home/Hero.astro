---
// Hero (variant A / B) — S-WEB-01, DRIVE-169. Devices are rendered here and sized in CSS from the column
// width (prototype formula: iw = min(250 | 300 px, 60 % of the column)), so nothing shifts when JS runs.
// The route behind is projected at runtime by scripts/home/hero.ts from compact geometry (hero-geo block).
import WaitlistForm from './WaitlistForm.astro';
import { device, screenRecap, screenStoryRing } from '../../lib/mockups';
import { smoothPath, type XY } from '../../lib/geo';
import { heroGeometry } from './hero-geometry';

const G = heroGeometry();
const devices =
  device('android', screenRecap(), { width: 0, cls: 'hero-android' }).replace('--w:0px;', '') +
  device('ios', screenStoryRing(), { width: 0, cls: 'hero-ios' }).replace('--w:0px;', '');

// No-JS fallback: the desktop composition at a nominal 1440 × 1000 hero, sliced to fit.
const fw = 1440, fh = 1000;
const B = { x: fw * 0.44, y: fh * 0.03, w: fw * 0.64, h: fh * 0.84 };
const sc = Math.min(B.w / G.sx, B.h / G.sy), ox = B.x + (B.w - G.sx * sc) / 2, oy = B.y + (B.h - G.sy * sc) / 2;
const P = (x: number, y: number): XY => [ox + x * sc, oy + y * sc];
const fallbackRoads = G.roads.map((r) => smoothPath(r.map(([x, y]) => P(x, y)))).join(' ');
const fallbackRoute = smoothPath(G.hero.map(([x, y]) => P(x, y)));
const fallbackClean = smoothPath(G.hero.filter((p) => p[2] >= G.cleanest[0] && p[2] <= G.cleanest[1]).map(([x, y]) => P(x, y)));
---
<section class="hero" aria-labelledby="hero-title" data-component="Hero">
  <div class="hero__route" aria-hidden="true">
    <svg id="hero-route"></svg>
    <noscript><svg viewBox={`0 0 ${fw} ${fh}`} preserveAspectRatio="xMaxYMid slice"><path d={fallbackRoads} fill="none" stroke="var(--line-strong)" stroke-width="1.4" stroke-linecap="round" opacity=".55"/><path d={fallbackRoute} fill="none" stroke="#5BE7C4" stroke-width="4" stroke-linecap="round"/><path d={fallbackClean} fill="none" stroke="#C6F8EA" stroke-width="6" stroke-linecap="round" opacity=".9"/></svg></noscript>
  </div>
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">Coming to iPhone and Android · early 2027</p>
      <h1 class="display" id="hero-title">
        <span data-variant-only="A">Smooth is<br>a <span class="gradient-text">skill.</span></span>
        <span data-variant-only="B">Every drive, <span class="gradient-text">decoded.</span></span>
      </h1>
      <p class="lede" data-variant-only="A"><strong>Every drive, decoded:</strong> automatic recording, a Smoothness score you can improve, and recaps worth sharing. Private by design.</p>
      <p class="lede" data-variant-only="B">Each drive becomes a 15-second Story, a replay with evidence and a <strong>weekly recap worth sharing.</strong> Recorded automatically. Private by design.</p>

      <WaitlistForm />

      <div class="hero__meta">
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8.5" r="3.5"/><path d="M5 20c1.2-3.6 3.9-5.5 7-5.5s5.8 1.9 7 5.5"/><path d="M4 4l16 16"/></svg>No account needed</span>
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7.5 3v5.5c0 4.6-3.2 8.2-7.5 9.5-4.3-1.3-7.5-4.9-7.5-9.5V6z"/><path d="M9 12l2.2 2.2L15.5 10"/></svg>Never sold or shared with insurers</span>
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="6.5" y="2.5" width="11" height="19" rx="3"/><path d="M10.5 18.5h3"/></svg>Just your phone. No hardware.</span>
      </div>
    </div>
    <div class="hero__devices-wrap">
      <div class="hero__devices" id="hero-devices" role="img" aria-label="DrivePerf on iPhone showing a Drive Story with a new route record of 91, and on Android showing a weekly recap with an average Smoothness of 87." set:html={devices}></div>
    </div>
  </div>
  <p class="hero__attrib">A real commute along the QEW and Gardiner, ends trimmed · Route geometry © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a></p>
  <script type="application/json" id="hero-geo" set:html={JSON.stringify(G)}></script>
</section>

<style is:global>
  /* Device layout in CSS (was layoutDevices() in home.js): iw = min(250px | 300px ≥ 960, 60 % of the column). */
  .hero__devices-wrap { container-type: inline-size; }
  .hero .hero__devices { --iw: min(250px, 60cqw); height: calc(var(--iw) * 2.08 + 56px); }
  @media (min-width: 960px) { .hero .hero__devices { --iw: min(300px, 60cqw); } }
  .hero__devices .hero-android { --w: calc(var(--iw) * .93); position: absolute; top: calc(var(--iw) * .22); left: calc(50% - var(--iw) * .93 * .98); }
  .hero__devices .hero-ios { --w: var(--iw); position: absolute; top: 0; left: calc(50% - var(--iw) * .12); }
  .hero__route noscript svg { position: absolute; inset: 0; width: 100%; height: 100%; }
</style>

<script>
  import '../../scripts/home/ab';
  import '../../scripts/home/hero';
</script>
