---
import FaqList from './FaqList.astro';
---
<section class="section" aria-labelledby="faq-title" data-component="FaqTeaser">
  <div class="wrap wrap--mid split split--wide-left" style="align-items:start">
    <div>
      <p class="eyebrow">Questions</p>
      <h2 class="h2" id="faq-title">Straight answers.</h2>
      <p class="lede" style="margin-top:20px">The things drivers ask us first.</p>
      <p style="margin-top:24px"><a class="link-arrow" href="/support">All questions and support</a></p>
    </div>
    <FaqList />
  </div>
</section>
