---
// PassCard (S-WEB-08): 30 days of Pro, what's included, who it's from; dashed tear line from site.css (.pass).
// The sender's name needs the pass API (DRIVE-76), so the card says "From a friend" until then.
import LoopMark from '../site/LoopMark.astro';
import IconSlot from './IconSlot.astro';
---
<div class="pass" aria-label="Ride-along pass: 30 days of DrivePerf Pro" role="img">
  <div class="pass__top"><span class="brand" style="pointer-events:none"><LoopMark size={30} /><span class="brand__word" style="font-size:17px">DrivePerf</span></span><span class="chip chip--accent">Pro</span></div>
  <div class="pass__days"><span class="num">30</span><span class="h3">days of Pro</span></div>
  <p class="muted small" style="margin:0">Replay every drive, unlimited routes, ghost comparison, trends and cloud backup.</p>
  <div class="pass__from"><span class="avatar"><IconSlot name="passenger" style="--is:20px" /></span><div><b style="display:block">From a friend</b><span class="small muted">Ride-along pass</span></div></div>
</div>
