{
  "hosting": {
    "target": "api",
    "public": "static",
    "cleanUrls": false,
    "trailingSlash": false,
    "ignore": ["firebase.json", "**/.DS_Store"],
    "rewrites": [
      { "source": "**", "run": { "serviceId": "api", "region": "us-central1" } }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "no-referrer" }
        ]
      }
    ]
  }
}
