{
  "name": "@driveperf/firebase",
  "private": true,
  "type": "module",
  "description": "Firestore rules, indexes and Hosting config for driveperf-dev / driveperf-prod (ADR-002, ADR-008), with emulator tests.",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-driveperf \"vitest run --no-file-parallelism\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-driveperf",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.2.0",
    "firebase-tools": "15.35.0",
    "vitest": "5.1.0"
  }
}
