-- DRIVE-131 (pipeline-and-scoring.md §5.7 "Corrections"): what a recompute after a correction, a deletion or event
-- feedback reads. Finished, live trips from a start time onwards, oldest first, with their scores, route matches and
-- spans read in bulk rather than per trip.

finishedFrom:
SELECT * FROM trip
WHERE status IN ('FINALISED', 'INTERRUPTED') AND deleted_at IS NULL AND started_at >= ?
ORDER BY started_at ASC, id ASC;

scoresFrom:
SELECT * FROM score WHERE trip_id IN (
  SELECT id FROM trip WHERE status IN ('FINALISED', 'INTERRUPTED') AND deleted_at IS NULL AND started_at >= ?
);

routeMatchesFrom:
SELECT * FROM route_match WHERE trip_id IN (
  SELECT id FROM trip WHERE status IN ('FINALISED', 'INTERRUPTED') AND deleted_at IS NULL AND started_at >= ?
);

segmentsFrom:
SELECT * FROM trip_segment WHERE trip_id IN (
  SELECT id FROM trip WHERE status IN ('FINALISED', 'INTERRUPTED') AND deleted_at IS NULL AND started_at >= ?
)
ORDER BY trip_id, seq;

-- Where the recompute after a deletion starts: the first finished trip at or after the deleted trip's start.
firstFinishedFrom:
SELECT id FROM trip
WHERE status IN ('FINALISED', 'INTERRUPTED') AND deleted_at IS NULL AND started_at >= ?
ORDER BY started_at ASC, id ASC
LIMIT 1;
