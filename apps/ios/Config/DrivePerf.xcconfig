// Project-level settings for every target and configuration. Committed values are the shipping identity:
// com.driveperf.app (Release) and com.driveperf.app.dev (Debug), unsigned. Local overrides go in the gitignored
// Config/Local.xcconfig (see Local.xcconfig.example and apps/ios/README.md "Run it on your iPhone").

// Bundle IDs, registered with the widget IDs (.widgets) and group.com.driveperf.app in the paid Apple Developer team
// (DRIVE-42). Sign them only with that team, never with a free Personal Team.
DP_APP_ID_RELEASE = com.driveperf.app
DP_APP_ID_DEBUG = com.driveperf.app.dev

// Simulator-only signing by default (CI, tools/run-ios.sh). Device builds set the team in Local.xcconfig.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

// Entitlements per target. The committed values are the shipping entitlements. Only the Personal Team fallback in
// Local.xcconfig points these at the *.personal-team.entitlements variants (no App Group).
DP_ENTITLEMENTS_APP = Config/DrivePerf.entitlements
DP_ENTITLEMENTS_WIDGETS = Config/DrivePerfWidgets.entitlements

// Crash reporting (ADR-007): Sentry EU DSN, injected at build time, never committed. Empty = stub only.
DP_SENTRY_DSN =

// Features the paid Apple Developer account makes possible (DRIVE-42 bought it). Each stays NO until its feature is
// built: Sign in with Apple and push need their capability on the App IDs first, TestFlight needs the release lane.
DP_FEATURE_SIGN_IN_WITH_APPLE = NO
DP_FEATURE_PUSH = NO
DP_FEATURE_TESTFLIGHT = NO

#include? "Local.xcconfig"
