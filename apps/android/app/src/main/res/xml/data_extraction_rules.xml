<?xml version="1.0" encoding="utf-8"?>
<!-- Local-first and private by default (PRD privacy rules): nothing is copied to Google cloud backup or to a new
     device by the platform. Pro backup is DrivePerf's own opt-in sync, not Android Auto Backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
