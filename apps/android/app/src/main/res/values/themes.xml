<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window background matches the Night Drive surface so there is no white flash before Compose draws.
         System bar icon colours are set at runtime by enableEdgeToEdge(). -->
    <style name="Theme.DrivePerf" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
